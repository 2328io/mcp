NODE_ENV=development
TRANSPORT=http
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=https://mcp.example.com
MCP_PATH=/mcp
API_BASE_URL=https://api.2328.io/api/v1
API_TIMEOUT_MS=8000
MCP_RATE_LIMIT_PER_MINUTE=600
REDIS_URL=redis://redis:6379
# Production may read these values from Docker secrets instead.
REDIS_PASSWORD_FILE=
# Generate with: bun -e "console.log(crypto.getRandomValues(new Uint8Array(32)).toBase64({alphabet:'base64url',omitPadding:true}))"
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_FILE=
ACCESS_TOKEN_TTL_SECONDS=900
AUTH_CODE_TTL_SECONDS=120
PREPARATION_TTL_SECONDS=300
CONVERT_PREPARATION_TTL_SECONDS=60
ALLOWED_ORIGINS=
TRUST_PROXY=false
LOG_LEVEL=info

# stdio only
PROJECT_ID=
API_KEY=
PAYOUT_API_KEY=
